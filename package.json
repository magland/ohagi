{
  "name": "@magland/ohagi",
  "version": "0.0.1",
  "description": "A self-hosted LaTeX editor with the shape of Overleaf, where several people edit one file at once, from one small server with no database.",
  "main": "dist/ohagi/src/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/build-client.mjs --minify",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client",
    "example": "tsx scripts/create-example.ts example-root",
    "dev": "node scripts/build-client.mjs && tsx src/index.ts serve example-root",
    "test": "node scripts/build-client.mjs && node --import tsx --test tests/*.test.ts",
    "start": "node dist/ohagi/src/index.js serve"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@codemirror/collab": "^6.1.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@vscode/markdown-it-katex": "^1.1.2",
    "aws4fetch": "^1.0.20",
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.10",
    "markdown-it": "^14.3.2",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "sanitize-html": "^2.18.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.4",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "bin": {
    "ohagi": "dist/ohagi/src/index.js"
  },
  "engines": {
    "node": ">=20"
  }
}
